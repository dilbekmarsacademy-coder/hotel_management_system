rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(uid())).data;
    }

    function role() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(uid()))
        ? userDoc().role
        : 'guest';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isManager() {
      return role() == 'manager' || isAdmin();
    }

    function isReceptionist() {
      return role() == 'receptionist' || isManager();
    }

    function isHousekeeping() {
      return role() == 'housekeeping' || isManager();
    }

    function isRestaurantStaff() {
      return role() == 'restaurantStaff' || isManager();
    }

    function isMaintenance() {
      return role() == 'maintenance' || isManager();
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    // ── Users ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isReceptionist();
      // New users may only create themselves as guest
      allow create: if isSignedIn() && isOwner(userId)
        && request.resource.data.role == 'guest';
      // Owners may update profile fields but NEVER role / isActive
      allow update: if isAdmin()
        || (isOwner(userId)
            && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['role', 'isActive']));
      allow delete: if isAdmin();
    }

    // ── Rooms (public read, staff write) ─────────────────────
    match /rooms/{roomId} {
      allow read: if true; // Public catalog
      allow create, update, delete: if isManager() || isReceptionist();
    }

    // ── Bookings ─────────────────────────────────────────────
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.guestId == uid() ||
        isReceptionist() ||
        isHousekeeping()
      );
      allow create: if isSignedIn() && (
        request.resource.data.guestId == uid() ||
        isReceptionist()
      );
      allow update: if isSignedIn() && (
        (resource.data.guestId == uid() &&
          request.resource.data.status in ['cancelled']) ||
        isReceptionist()
      );
      allow delete: if isAdmin();
    }

    // ── Menu / Restaurant ────────────────────────────────────
    match /menuItems/{itemId} {
      allow read: if true;
      allow write: if isRestaurantStaff() || isManager();
    }

    match /restaurantMenu/{itemId} {
      allow read: if true;
      allow write: if isRestaurantStaff() || isManager();
    }

    match /orders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.guestId == uid() ||
        isRestaurantStaff() ||
        isReceptionist()
      );
      allow create: if isSignedIn();
      allow update: if isRestaurantStaff() || isManager() ||
        (isSignedIn() && resource.data.guestId == uid() &&
          request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    match /restaurantOrders/{orderId} {
      allow read: if isSignedIn() && (
        resource.data.guestId == uid() ||
        isRestaurantStaff() ||
        isReceptionist()
      );
      allow create: if isSignedIn();
      allow update: if isRestaurantStaff() || isManager() ||
        (isSignedIn() && resource.data.guestId == uid() &&
          request.resource.data.status == 'cancelled');
      allow delete: if isAdmin();
    }

    // ── Services ─────────────────────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isManager();
    }

    // ── Payments & Invoices ──────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isSignedIn() && (
        resource.data.guestId == uid() ||
        isReceptionist() ||
        isManager()
      );
      // Guests may create pending payments only
      allow create: if isSignedIn()
        && request.resource.data.status == 'pending';
      // Only staff can change status (Paid/Refunded)
      allow update: if isReceptionist() || isManager();
      allow delete: if isAdmin();
    }

    match /invoices/{invoiceId} {
      allow read: if isSignedIn() && (
        resource.data.guestId == uid() ||
        isReceptionist() ||
        isManager()
      );
      allow write: if isReceptionist() || isManager();
    }

    // ── Reviews ──────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.guestId == uid();
      allow update, delete: if isSignedIn() && (
        resource.data.guestId == uid() || isAdmin()
      );
    }

    // ── Notifications ────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && resource.data.userId == uid();
      allow update: if isSignedIn() && resource.data.userId == uid();
      allow create: if isManager() || isReceptionist();
      allow delete: if isSignedIn() && resource.data.userId == uid();
    }

    // ── Housekeeping ─────────────────────────────────────────
    match /housekeepingTasks/{taskId} {
      allow read: if isHousekeeping() || isReceptionist();
      allow create: if isReceptionist() || isHousekeeping();
      allow update: if isHousekeeping() || isReceptionist();
      allow delete: if isManager();
    }

    // ── Maintenance ──────────────────────────────────────────
    match /maintenanceRequests/{reqId} {
      allow read: if isMaintenance() || isReceptionist() || isManager();
      allow create: if isSignedIn(); // Guests can report issues
      allow update: if isMaintenance() || isManager();
      allow delete: if isManager();
    }

    // ── Staff ────────────────────────────────────────────────
    match /staff/{staffId} {
      allow read: if isManager() || isReceptionist();
      allow write: if isManager();
    }

    // ── Promotions & Coupons ─────────────────────────────────
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isManager();
    }

    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow write: if isManager();
    }

    // ── Loyalty ──────────────────────────────────────────────
    match /loyalty/{userId} {
      allow read: if isOwner(userId) || isManager();
      allow write: if isManager();
    }

    // ── Settings ─────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Audit logs ───────────────────────────────────────────
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isManager();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
