rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isManager() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager'];
    }
    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }
    function underSize() {
      return request.resource.size < 5 * 1024 * 1024; // 5 MB
    }

    // Profile avatars – owner only
    match /users/{userId}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && isImage() && underSize();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Room images – staff write, public read
    match /rooms/{roomId}/{allPaths=**} {
      allow read: if true;
      allow write: if isManager() && isImage() && underSize();
      allow delete: if isManager();
    }

    // Menu images
    match /menu/{itemId}/{allPaths=**} {
      allow read: if true;
      allow write: if isManager() && isImage() && underSize();
      allow delete: if isManager();
    }

    // Service images
    match /services/{serviceId}/{allPaths=**} {
      allow read: if true;
      allow write: if isManager() && isImage() && underSize();
      allow delete: if isManager();
    }

    // Hotel gallery
    match /hotel/gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isManager() && isImage() && underSize();
      allow delete: if isManager();
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
